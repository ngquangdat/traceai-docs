  "cards": [
    {
      "dot": "cyan",
      "title": "Why the cost stays small",
      "items": [
        "Each step hands the model a smaller set than the one before",
        "Only tens to a few hundred filtered lines ever reach the context",
        "The full log volume is never paid for as tokens"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pull, not push",
      "items": [
        "The agent asks for evidence; nothing is streamed at it",
        "Tool choice is made per step from what the last result showed",
        "Roughly 26 tool calls in an average run"
      ]
    },
    {
      "dot": "rose",
      "title": "Bounded by design",
      "items": [
        "Iteration warnings precede a hard forced-final step",
        "With tools disabled the model must conclude or state what is missing",
        "No unbounded agent loop can run up a bill"
      ]
    }
  ]
