  "cards": [
    {
      "dot": "cyan",
      "title": "Cross-stack evidence",
      "items": [
        "Four production systems stitched by distributed trace ID",
        "Sentry additional_data bridges a frontend event to its backend trace",
        "tree-sitter code graph resolves callers and callees"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agent control",
      "items": [
        "Plan → call tools → verify → structured report",
        "Iteration budget, then a forced-final step with tools disabled",
        "Pydantic-validated JSON; every claim cites a log line or file:line"
      ]
    },
    {
      "dot": "rose",
      "title": "Security posture",
      "items": [
        "Agent runs on the caller's own tokens, AES-256-GCM at rest",
        "No shared super-token exists anywhere in the system",
        "Read-only by default; Auto Fix opens a draft PR humans merge"
      ]
    }
  ]
