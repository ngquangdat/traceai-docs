  "cards": [
    {
      "dot": "rose",
      "title": "Detected entities",
      "items": [
        "CCCD 12 digits, CMND 9 digits, phone, bank and securities accounts",
        "Vietnamese names made NER-detectable by stripping diacritics first",
        "Custom recognizers for TCBS identifiers sit beside Presidio defaults"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where the real data lives",
      "items": [
        "The placeholder map exists only in process memory",
        "It is never written to disk, logs, or the model request",
        "Restoration happens after the response returns, for that caller only"
      ]
    },
    {
      "dot": "cyan",
      "title": "Why this matters here",
      "items": [
        "A bank cannot send customer identifiers to a model provider",
        "Bedrock runs in-region inside our own AWS account",
        "Anthropic and AWS do not train on this traffic"
      ]
    }
  ]
